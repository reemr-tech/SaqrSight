# Copy to .env (never commit .env). All values are optional; the core assessment works without any keys.
# Load with:  set -a; source .env; set +a   before starting uvicorn.

# Storage
# SAQRSIGHT_DATA_DIR=./data
# SAQRSIGHT_RETENTION_DAYS=90          # reports older than this are deleted at startup (0 = keep)

# Upload limits (shown to users before submission)
# SAQRSIGHT_MAX_TEXT_CHARS=10000
# SAQRSIGHT_MAX_IMAGE_MB=10
# SAQRSIGHT_MAX_IMAGE_PIXELS=20000000
# SAQRSIGHT_MIN_IMAGE_SIDE=32
# SAQRSIGHT_MAX_VIDEO_MB=50
# SAQRSIGHT_MAX_VIDEO_SECONDS=60
# SAQRSIGHT_VIDEO_FRAMES=5

# Models (downloaded from Hugging Face on first use)
# SAQRSIGHT_ENABLE_MODELS=1
# SAQRSIGHT_VISUAL_MODEL=Organika/sdxl-detector
# SAQRSIGHT_MODULE_TIMEOUT=120

# Reverse image search (Google Cloud Vision, WEB_DETECTION feature)
GOOGLE_VISION_API_KEY=
# SAQRSIGHT_MAX_REVERSE_FRAMES=2

# Official-source search: brave (default) or google_cse
SAQRSIGHT_SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
# SAQRSIGHT_OFFICIAL_DOMAINS=wam.ae,u.ae,mediaoffice.ae,ncema.gov.ae,moi.gov.ae,dubaipolice.gov.ae,adpolice.gov.ae,ncm.gov.ae,mohap.gov.ae,mediaoffice.abudhabi
# SAQRSIGHT_HTTP_TIMEOUT=15
# SAQRSIGHT_MAX_SEARCH_QUERIES=4
